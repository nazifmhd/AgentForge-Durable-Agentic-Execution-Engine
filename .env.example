# Copy to .env and fill in. All keys are prefixed AGENTFORGE_.

AGENTFORGE_ENVIRONMENT=local
AGENTFORGE_LOG_LEVEL=INFO
AGENTFORGE_LOG_JSON=false

# Persistence
AGENTFORGE_DATABASE_URL=postgresql+asyncpg://agentforge:agentforge@localhost:5432/agentforge
AGENTFORGE_REDIS_URL=redis://localhost:6379/0

# Worker / durability
AGENTFORGE_LEASE_SECONDS=30
AGENTFORGE_LEASE_HEARTBEAT_SECONDS=10
AGENTFORGE_MAX_CONCURRENT_STEPS_PER_WORKER=8

# Budgets
AGENTFORGE_DEFAULT_WORKFLOW_BUDGET_USD=1.0
AGENTFORGE_ORG_DAILY_BUDGET_USD=100.0

# LLM providers
AGENTFORGE_ANTHROPIC_API_KEY=
AGENTFORGE_OPENAI_API_KEY=
AGENTFORGE_MODEL_REGISTRY_PATH=config/models.yaml

# Integrations (optional)
AGENTFORGE_N8N_BASE_URL=
AGENTFORGE_N8N_API_KEY=

# Observability (optional)
AGENTFORGE_OTEL_EXPORTER_OTLP_ENDPOINT=
AGENTFORGE_OTEL_SERVICE_NAME=agentforge

# API
AGENTFORGE_API_PORT=8000
